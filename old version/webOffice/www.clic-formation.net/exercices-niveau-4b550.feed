	<entry>
		<title>Cas Fiche commune - ❹</title>
		<link rel="alternate" type="text/html" href="https://www.clic-formation.net/exercices-niveau-4/fiche-commune.html"/>
		<published>2023-12-20T16:41:22+00:00</published>
		<updated>2023-12-20T16:41:22+00:00</updated>
		<id>https://www.clic-formation.net/exercices-niveau-4/fiche-commune.html</id>
		<author>
			<name>Webmaster Clic-formation.net</name>
			<email>thierry.didoli@gmail.com</email>
		</author>
		<summary type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-4/fiche-commune/resultat-01.gif&quot; class=&quot;wfpopup wf-zoom-image jcepopup&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-4/fiche-commune/resultat-01.gif&quot; alt=&quot;Vue du résultat attendu de l'exercice word : &amp;quot;Fiche commune&amp;quot;&quot; width=&quot;100&quot; height=&quot;142&quot; style=&quot;margin: 5px 20px 5px 5px; padding: 0px; border: 1px solid #000000; float: left;&quot; /&gt;&lt;/a&gt;Dans cet exercice, vous travaillez&amp;nbsp;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;la table des matières&lt;/li&gt;
&lt;li&gt;l'encadrement des titres&lt;/li&gt;
&lt;li&gt;l'insertion de tableau&lt;/li&gt;
&lt;li&gt;la pagination&lt;/li&gt;
&lt;li&gt;l'insertion des zones de textes&lt;/li&gt;
&lt;li&gt;les listes à puces.&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-4/fiche-commune.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</summary>
