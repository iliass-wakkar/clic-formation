    <h3 data-rlta-element="heading">
    VIDEO: Comment ça marche les centrales nucléaires</h3>
</div>
<div id="rlta-panel-video-comment-ca-marche-les-centrales-nucleaires" aria-labelledby="rlta-video-comment-ca-marche-les-centrales-nucleaires" tabindex="-1" class="orange" hidden="true" data-rlta-element="panel" data-rlta-state="closed" data-rlta-color="false">
