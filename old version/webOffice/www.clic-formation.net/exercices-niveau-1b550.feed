	<entry>
		<title>Cas Lycée - ❶</title>
		<link rel="alternate" type="text/html" href="https://www.clic-formation.net/exercices-niveau-1/lycee.html"/>
		<published>2023-12-20T16:41:22+00:00</published>
		<updated>2023-12-20T16:41:22+00:00</updated>
		<id>https://www.clic-formation.net/exercices-niveau-1/lycee.html</id>
		<author>
			<name>Webmaster Clic-formation.net</name>
			<email>thierry.didoli@gmail.com</email>
		</author>
		<summary type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/lycee/lycee-resultat.jpg&quot; class=&quot;wfpopup wf-mediabox-has-float wf-zoom-image jcepopup&quot; style=&quot;float: left; margin-right: 10px;&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/lycee/lycee-resultat.jpg&quot; alt=&quot;Capture écran du résultat attendu de l'exercice 6&quot; width=&quot;100&quot; height=&quot;155&quot; style=&quot;margin: 5px 20px 5px 5px; padding: 0px; float: left;&quot; /&gt;&lt;/a&gt;Sur ce courrier simple, vous travaillez&amp;nbsp;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;L'insertion d'image (en-tête ou pas)&lt;/li&gt;
&lt;li&gt;Attributs de texte et de paragraphe&lt;/li&gt;
&lt;li&gt;Pied de page&lt;/li&gt;
&lt;li&gt;Liste à puces&lt;/li&gt;
&lt;li&gt;Pied de page&lt;/li&gt;
&lt;li&gt;Tabulation simple&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-1/lycee.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</summary>
		<content type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/lycee/lycee-resultat.jpg&quot; class=&quot;wfpopup wf-mediabox-has-float wf-zoom-image jcepopup&quot; style=&quot;float: left; margin-right: 10px;&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/lycee/lycee-resultat.jpg&quot; alt=&quot;Capture écran du résultat attendu de l'exercice 6&quot; width=&quot;100&quot; height=&quot;155&quot; style=&quot;margin: 5px 20px 5px 5px; padding: 0px; float: left;&quot; /&gt;&lt;/a&gt;Sur ce courrier simple, vous travaillez&amp;nbsp;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;L'insertion d'image (en-tête ou pas)&lt;/li&gt;
&lt;li&gt;Attributs de texte et de paragraphe&lt;/li&gt;
&lt;li&gt;Pied de page&lt;/li&gt;
&lt;li&gt;Liste à puces&lt;/li&gt;
&lt;li&gt;Pied de page&lt;/li&gt;
&lt;li&gt;Tabulation simple&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-1/lycee.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</content>
