	<entry>
		<title>Cas CB Nettoyage - ❶</title>
		<link rel="alternate" type="text/html" href="https://www.clic-formation.net/exercices-niveau-1/cb-nettoyage.html"/>
		<published>2023-12-20T16:41:22+00:00</published>
		<updated>2023-12-20T16:41:22+00:00</updated>
		<id>https://www.clic-formation.net/exercices-niveau-1/cb-nettoyage.html</id>
		<author>
			<name>Webmaster Clic-formation.net</name>
			<email>thierry.didoli@gmail.com</email>
		</author>
		<summary type="html">&lt;p&gt;D&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/cb-nettoyage/resultat-cb-nettoyage.gif&quot; class=&quot;jcepopup&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/cb-nettoyage/resultat-cb-nettoyage.gif&quot; alt=&quot;Capture écran du résultat attendu de l'exercice 2&quot; width=&quot;100&quot; height=&quot;146&quot; style=&quot;margin: 5px 20px 5px 5px; float: left;&quot; /&gt;&lt;/a&gt;ans cet exercice, vous travaillez :&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Présentation d'un courrier type &quot;devis&quot; classique.&lt;/li&gt;
&lt;li&gt;Alignement de texte et correspondance lettre à fenêtre.&lt;/li&gt;
&lt;li&gt;Liste à puce avec changement des puces de base pour trouver le &quot;rond&quot;&lt;/li&gt;
&lt;li&gt;Zone de texte texturées&lt;/li&gt;
&lt;li&gt;Tabulation pour la zone des prix en fin de courrier&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-1/cb-nettoyage.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</summary>
		<content type="html">&lt;p&gt;D&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/cb-nettoyage/resultat-cb-nettoyage.gif&quot; class=&quot;jcepopup&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/cb-nettoyage/resultat-cb-nettoyage.gif&quot; alt=&quot;Capture écran du résultat attendu de l'exercice 2&quot; width=&quot;100&quot; height=&quot;146&quot; style=&quot;margin: 5px 20px 5px 5px; float: left;&quot; /&gt;&lt;/a&gt;ans cet exercice, vous travaillez :&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Présentation d'un courrier type &quot;devis&quot; classique.&lt;/li&gt;
&lt;li&gt;Alignement de texte et correspondance lettre à fenêtre.&lt;/li&gt;
&lt;li&gt;Liste à puce avec changement des puces de base pour trouver le &quot;rond&quot;&lt;/li&gt;
&lt;li&gt;Zone de texte texturées&lt;/li&gt;
&lt;li&gt;Tabulation pour la zone des prix en fin de courrier&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-1/cb-nettoyage.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</content>
		<category term="Exercice word Niveau 1" />
	</entry>
	<entry>
		<title>Cas Crédit Carte - ❶</title>
		<link rel="alternate" type="text/html" href="https://www.clic-formation.net/exercices-niveau-1/credit-carte.html"/>
		<published>2023-12-20T16:41:22+00:00</published>
		<updated>2023-12-20T16:41:22+00:00</updated>
		<id>https://www.clic-formation.net/exercices-niveau-1/credit-carte.html</id>
		<author>
			<name>Webmaster Clic-formation.net</name>
			<email>thierry.didoli@gmail.com</email>
		</author>
		<summary type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/credit-carte/credit-carte-ex.jpg&quot; class=&quot;wfpopup wf-mediabox-has-float wf-zoom-image jcepopup&quot; style=&quot;float: left; margin-right: 10px;&quot; data-mediabox=&quot;1&quot;&gt;&lt;br /&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/credit-carte/credit-carte-ex.jpg&quot; alt=&quot;Capture écran du résultat attendu de l'exercice 3&quot; width=&quot;100&quot; height=&quot;131&quot; style=&quot;margin: 5px 20px 5px 5px; padding: 0px; float: left;&quot; /&gt;&lt;/a&gt;Sur ce courrier simple, vous travaillez&amp;nbsp;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Les attributs de paragraphes&lt;/li&gt;
&lt;li&gt;Les liste numérotées, + définition d'un nouveau format de numérotation. Cette dernière option est disponible dans Word et libre office dans le menu spécifique.&lt;/li&gt;
&lt;li&gt;Les alignements&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-1/credit-carte.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</summary>
		<content type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/credit-carte/credit-carte-ex.jpg&quot; class=&quot;wfpopup wf-mediabox-has-float wf-zoom-image jcepopup&quot; style=&quot;float: left; margin-right: 10px;&quot; data-mediabox=&quot;1&quot;&gt;&lt;br /&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/credit-carte/credit-carte-ex.jpg&quot; alt=&quot;Capture écran du résultat attendu de l'exercice 3&quot; width=&quot;100&quot; height=&quot;131&quot; style=&quot;margin: 5px 20px 5px 5px; padding: 0px; float: left;&quot; /&gt;&lt;/a&gt;Sur ce courrier simple, vous travaillez&amp;nbsp;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Les attributs de paragraphes&lt;/li&gt;
&lt;li&gt;Les liste numérotées, + définition d'un nouveau format de numérotation. Cette dernière option est disponible dans Word et libre office dans le menu spécifique.&lt;/li&gt;
&lt;li&gt;Les alignements&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-1/credit-carte.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</content>
		<category term="Exercice word Niveau 1" />
	</entry>
	<entry>
		<title>Cas Documentation - ❶</title>
		<link rel="alternate" type="text/html" href="https://www.clic-formation.net/exercices-niveau-1/documentation.html"/>
		<published>2023-12-20T16:41:22+00:00</published>
		<updated>2023-12-20T16:41:22+00:00</updated>
		<id>https://www.clic-formation.net/exercices-niveau-1/documentation.html</id>
		<author>
			<name>Webmaster Clic-formation.net</name>
			<email>thierry.didoli@gmail.com</email>
		</author>
		<summary type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/documentation/resultat-documentation.jpg&quot; class=&quot;jcepopup&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/documentation/resultat-documentation.jpg&quot; alt=&quot;resultat artesi 2&quot; width=&quot;100&quot; height=&quot;118&quot; style=&quot;margin: 5px 20px 5px 5px; float: left; border: #000000;&quot; /&gt;&lt;/a&gt;Dans cet exercice il vous faudra faire&amp;nbsp;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Titre sur 3 lignes et encadré&lt;/li&gt;
&lt;li&gt;Paragraphe 1 justifié début de ligne à 2 sur la règle et fin de ligne à 14&lt;/li&gt;
&lt;li&gt;Paragraphe 2 et 3 alignés à gauche, début de ligne à 1 sur la règle.&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-1/documentation.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</summary>
		<content type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/documentation/resultat-documentation.jpg&quot; class=&quot;jcepopup&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-1/documentation/resultat-documentation.jpg&quot; alt=&quot;resultat artesi 2&quot; width=&quot;100&quot; height=&quot;118&quot; style=&quot;margin: 5px 20px 5px 5px; float: left; border: #000000;&quot; /&gt;&lt;/a&gt;Dans cet exercice il vous faudra faire&amp;nbsp;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Titre sur 3 lignes et encadré&lt;/li&gt;
&lt;li&gt;Paragraphe 1 justifié début de ligne à 2 sur la règle et fin de ligne à 14&lt;/li&gt;
&lt;li&gt;Paragraphe 2 et 3 alignés à gauche, début de ligne à 1 sur la règle.&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-1/documentation.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</content>
		<category term="Exercice word Niveau 1" />
	</entry>
	<entry>
		<title>Cas Internet - ❶</title>
		<link rel="alternate" type="text/html" href="https://www.clic-formation.net/exercices-niveau-1/internet.html"/>
		<published>2023-12-20T16:41:22+00:00</published>
