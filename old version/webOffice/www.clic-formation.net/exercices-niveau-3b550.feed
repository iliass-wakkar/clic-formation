		<author>
			<name>Webmaster Clic-formation.net</name>
			<email>thierry.didoli@gmail.com</email>
		</author>
		<summary type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-3/facebook/facebook-resultat.webp&quot; class=&quot;jcepopup&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-3/facebook/facebook-resultat.webp&quot; alt=&quot;Vue du résultat attendu de l'exercice word : &amp;quot;Campagne FB&amp;quot;&quot; width=&quot;154&quot; height=&quot;109&quot; style=&quot;margin: 5px 20px 5px 5px; border: 1px solid #000000; float: left;&quot; /&gt;&lt;/a&gt;Vous allez travailler&amp;nbsp;:&lt;/p&gt;
