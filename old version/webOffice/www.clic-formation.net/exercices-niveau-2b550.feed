	<entry>
		<title>Cas Carré - ❷</title>
		<link rel="alternate" type="text/html" href="https://www.clic-formation.net/exercices-niveau-2/carre-de-couleur.html"/>
		<published>2023-12-20T16:41:22+00:00</published>
		<updated>2023-12-20T16:41:22+00:00</updated>
		<id>https://www.clic-formation.net/exercices-niveau-2/carre-de-couleur.html</id>
		<author>
			<name>Webmaster Clic-formation.net</name>
			<email>thierry.didoli@gmail.com</email>
		</author>
		<summary type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-2/carre/resultat-carre.gif&quot; class=&quot;jcepopup&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-2/carre/resultat-carre.gif&quot; alt=&quot;Capture écran du résultat attendu de l'exercice 3&quot; width=&quot;191&quot; height=&quot;184&quot; style=&quot;margin: 5px 20px 5px 5px; border: #000000; float: left;&quot; /&gt;&lt;/a&gt;Dans cet exercice, vous travaillez&amp;nbsp;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Taille de page à 20 cm * 20 cm&lt;/li&gt;
&lt;li&gt;Marge de 2.5 partout&lt;/li&gt;
&lt;li&gt;Tableau de 3 colonnes par 3 lignes&lt;/li&gt;
&lt;li&gt;Colorisé les cellules&lt;/li&gt;
&lt;li&gt;Bordures pointillées&lt;/li&gt;
&lt;li&gt;Centrer le contenu de chaque cellule horizontalement et verticalement.&lt;/li&gt;
&lt;li&gt;La police de l'exemple est &lt;strong&gt;Bernard MT Condensed&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-2/carre-de-couleur.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</summary>
		<content type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-2/carre/resultat-carre.gif&quot; class=&quot;jcepopup&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-2/carre/resultat-carre.gif&quot; alt=&quot;Capture écran du résultat attendu de l'exercice 3&quot; width=&quot;191&quot; height=&quot;184&quot; style=&quot;margin: 5px 20px 5px 5px; border: #000000; float: left;&quot; /&gt;&lt;/a&gt;Dans cet exercice, vous travaillez&amp;nbsp;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Taille de page à 20 cm * 20 cm&lt;/li&gt;
&lt;li&gt;Marge de 2.5 partout&lt;/li&gt;
&lt;li&gt;Tableau de 3 colonnes par 3 lignes&lt;/li&gt;
&lt;li&gt;Colorisé les cellules&lt;/li&gt;
&lt;li&gt;Bordures pointillées&lt;/li&gt;
&lt;li&gt;Centrer le contenu de chaque cellule horizontalement et verticalement.&lt;/li&gt;
&lt;li&gt;La police de l'exemple est &lt;strong&gt;Bernard MT Condensed&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-2/carre-de-couleur.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</content>
		<category term="Exercice word Niveau 2" />
	</entry>
	<entry>
		<title>Cas Eco Services - ❷</title>
		<link rel="alternate" type="text/html" href="https://www.clic-formation.net/exercices-niveau-2/eco-services.html"/>
		<published>2023-12-20T16:41:22+00:00</published>
		<updated>2023-12-20T16:41:22+00:00</updated>
		<id>https://www.clic-formation.net/exercices-niveau-2/eco-services.html</id>
		<author>
			<name>Webmaster Clic-formation.net</name>
			<email>thierry.didoli@gmail.com</email>
		</author>
		<summary type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-2/eco-services/page-01.webp&quot; class=&quot;jcepopup&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-2/eco-services/page-01.webp&quot; alt=&quot;Capture écran du résultat attendu de l'exercice 3 - Page 1&quot; width=&quot;120&quot; height=&quot;170&quot; style=&quot;margin: 5px; float: left;&quot; /&gt;&lt;/a&gt;Dans cet exercice, vous travaillez&amp;nbsp;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Le titre eco services est à faire avec un Word art simple&lt;/li&gt;
&lt;li&gt;L'encadré Eco Services est à faire avec une zone de texte ou plus élégant avec la création d'un style.&lt;/li&gt;
&lt;li&gt;La première partie du document est à mettre en 2 colonnes, la seconde en trois colonnes.&lt;/li&gt;
&lt;li&gt;L'encadrement page et zone de texte est en tiret vert&lt;/li&gt;
&lt;li&gt;Selon la version de votre logiciel de traitement de texte, vous serez peut-être obligé d'insérer des sauts de sections.&lt;/li&gt;
&lt;li&gt;Les deux images sont sans souci&lt;/li&gt;
&lt;li&gt;L'arrière-plan est un filigrane (éventuellement dans l'en-tête)&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-2/eco-services.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</summary>
		<content type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-2/eco-services/page-01.webp&quot; class=&quot;jcepopup&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-2/eco-services/page-01.webp&quot; alt=&quot;Capture écran du résultat attendu de l'exercice 3 - Page 1&quot; width=&quot;120&quot; height=&quot;170&quot; style=&quot;margin: 5px; float: left;&quot; /&gt;&lt;/a&gt;Dans cet exercice, vous travaillez&amp;nbsp;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Le titre eco services est à faire avec un Word art simple&lt;/li&gt;
&lt;li&gt;L'encadré Eco Services est à faire avec une zone de texte ou plus élégant avec la création d'un style.&lt;/li&gt;
&lt;li&gt;La première partie du document est à mettre en 2 colonnes, la seconde en trois colonnes.&lt;/li&gt;
&lt;li&gt;L'encadrement page et zone de texte est en tiret vert&lt;/li&gt;
&lt;li&gt;Selon la version de votre logiciel de traitement de texte, vous serez peut-être obligé d'insérer des sauts de sections.&lt;/li&gt;
&lt;li&gt;Les deux images sont sans souci&lt;/li&gt;
&lt;li&gt;L'arrière-plan est un filigrane (éventuellement dans l'en-tête)&lt;/li&gt;
&lt;/ul&gt;
&lt;p class=&quot;feed-readmore&quot;&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://www.clic-formation.net/exercices-niveau-2/eco-services.html&quot; rel=&quot;noopener&quot;&gt;Lire la suite...&lt;/a&gt;&lt;/p&gt;</content>
		<category term="Exercice word Niveau 2" />
	</entry>
