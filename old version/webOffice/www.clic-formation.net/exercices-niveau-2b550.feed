			<name>Webmaster Clic-formation.net</name>
			<email>thierry.didoli@gmail.com</email>
		</author>
		<summary type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-2/cambre-ase/resultat-rando-cambre-page-01.jpg&quot; class=&quot;jcepopup&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-2/cambre-ase/resultat-rando-cambre-page-01.jpg&quot; alt=&quot;Capture écran du résultat attendu de l'exercice 10, cas &amp;quot;Randonnée Cambre d'Ase&amp;quot;&quot; width=&quot;281&quot; height=&quot;199&quot; style=&quot;margin: 5px 20px 5px 5px; float: left;&quot; /&gt;&lt;/a&gt;Dans cet exercice, vous travaillez un document en 8 pages :&lt;/p&gt;
&lt;ul&gt;
