	<entry>
		<title>Cas Menu restaurant - ❷</title>
		<link rel="alternate" type="text/html" href="https://www.clic-formation.net/exercices-niveau-2/menu-restaurant.html"/>
		<published>2023-12-20T16:41:22+00:00</published>
		<updated>2023-12-20T16:41:22+00:00</updated>
		<id>https://www.clic-formation.net/exercices-niveau-2/menu-restaurant.html</id>
		<author>
			<name>Webmaster Clic-formation.net</name>
			<email>thierry.didoli@gmail.com</email>
		</author>
		<summary type="html">&lt;p&gt;&lt;a href=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-2/menu/menu.webp&quot; class=&quot;wfpopup wf-mediabox-has-float wf-zoom-image jcepopup&quot; style=&quot;float: left; margin-right: 10px;&quot; data-mediabox=&quot;1&quot;&gt;&lt;img src=&quot;https://www.clic-formation.net/images/02-word/bibliotheque/niveau-2/menu/menu.webp&quot; alt=&quot;Capture écran du résultat attendu de l'exercice 7, cas &amp;quot;Menu restaurant&amp;quot;&quot; width=&quot;184&quot; height=&quot;128&quot; style=&quot;margin: 5px 20px 5px 5px; padding: 0px; float: left;&quot; /&gt;&lt;/a&gt;Dans cet exercice, vous travaillez&amp;nbsp;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Les tabulations et point de suite&lt;/li&gt;
&lt;li&gt;Retrait gauche&lt;/li&gt;
&lt;li&gt;Insertion symbole&lt;/li&gt;
&lt;li&gt;Insertion saut de page&lt;/li&gt;
&lt;li&gt;Choix de police original&lt;/li&gt;
&lt;/ul&gt;
